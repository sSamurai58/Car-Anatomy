# ---------------------------------------------------------------------------
# Kling AI video (provider locked)
# https://kling.ai/document-api/api/get-started/authentication
# Base URL (global / outside China): https://api-singapore.klingai.com
#
# Preferred — current official API Key auth (Bearer):
KLING_API_KEY=
# Alias also accepted: KLINGAI_API_KEY=
#
# Legacy — Access Key + Secret Key → HS256 JWT Bearer (30 min):
# Use when your console still issues AK/SK instead of a single API key.
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# Aliases: KLINGAI_ACCESS_KEY=  KLINGAI_SECRET_KEY=
#
# Optional Kling tuning:
# AI_VIDEO_PROVIDER=kling
# KLING_API_BASE=https://api-singapore.klingai.com
# KLING_API_MODE=path          # path (default) | legacy
# KLING_TEXT2VIDEO_MODEL=kling-2.6
# KLING_MODEL_NAME=kling-v2-6  # legacy mode only
# KLING_RESOLUTION=720p
# KLING_NATIVE_AUDIO=off
# KLING_MODE=std
# KLING_POLL_INTERVAL=8
# KLING_POLL_TIMEOUT=600
# ---------------------------------------------------------------------------

# YouTube Data API v3 + OAuth (channel upload)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Trial publish: private|unlisted|public
YOUTUBE_DEFAULT_PRIVACY=private
